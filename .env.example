# Copy to .env and fill in your values. Never commit .env to GitHub.

# OpenAI API (optional — app works without it via rule-based fallbacks)
OPENAI_API_KEY=

# Supabase (Phase 2 — create project at https://supabase.com)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: service role key — only for admin/server tasks, keep secret
# SUPABASE_SERVICE_ROLE_KEY=

# Backend production settings (one worker / one replica only)
FINIO_ENV=development
FINIO_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FINIO_CURRENCY=AUD
FINIO_LOCALE=en-AU
FINIO_LOG_LEVEL=INFO
# Set to 1 for deterministic offline tests; use 0 for AI-enabled production.
FINIO_DISABLE_LLM=0

# Vercel frontend build variables (public values only, NOT server secrets)
# FINIO_API_BASE_URL=https://your-api.example.com
# FINIO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# FINIO_PUBLIC_SUPABASE_KEY=sb_publishable_...
